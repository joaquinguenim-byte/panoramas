// Panoramas data model.
// Postgres everywhere (local Docker / Supabase / Neon). DATABASE_URL is the
// pooled connection used by the app; DIRECT_URL is the direct one used by migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  emailVerifiedAt DateTime?
  name         String
  birthDate    DateTime
  // "woman" | "man" | "nonbinary" | "unspecified" (self-declared, used for women-only events)
  gender       String   @default("unspecified")
  lgbtq        Boolean  @default(false) // self-declared, used for LGBTQ+-only events
  vegan        Boolean  @default(false) // self-declared, used for vegan-only events
  bio          String   @default("")
  comuna       String   @default("")
  interests    String   @default("") // comma-separated category keys
  contact      String   @default("") // what the user chooses to share (IG, phone...) when hosts allow it
  locale       String   @default("es")

  // Identity verification (STUB: format + check digit only; see src/lib/verification.ts)
  idType       String?  // "rut" | "passport" | "foreign_id"
  idNumber     String?  @unique
  verifiedAt   DateTime?
  // Photo of the ID document, uploaded at sign-up. Stored privately (never under /public).
  idDocPath       String?
  idDocUploadedAt DateTime?
  idDocStatus     String?  // "pending_review" | "approved" | "rejected" (manual / KYC review)
  idDocReviewedAt   DateTime?
  idDocReviewedById String?
  idDocRejectReason String?  // key: "unreadable" | "mismatch" | "underage" | "fake" | "other"

  // "user" | "moderator" | "admin". Staff can review ID documents and reports.
  role         String   @default("user")
  // Set by staff. A suspended person can't sign in and their plans are hidden.
  suspendedAt   DateTime?
  suspendReason String?

  createdAt    DateTime @default(now())

  sessions      Session[]
  tokens        AuthToken[]
  reportsMade     UserReport[] @relation("ReportsMade")
  reportsReceived UserReport[] @relation("ReportsReceived")
  blocking        Block[]      @relation("Blocking")
  blockedBy       Block[]      @relation("BlockedBy")
  hostedEvents  Event[]         @relation("HostedEvents")
  participations Participation[]
  messages      Message[]
  reports       Report[]
  memberships   CommunityMember[]
  createdCommunities Community[] @relation("CreatedCommunities")
}

/// A group like "CFA Society Chile" or "Corredores de Ñuñoa" that hosts plans.
model Community {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  kind        String   @default("open")    // "open" = anyone joins instantly | "closed" = admins approve requests
  whoCanPost  String   @default("members") // "members" | "admins": who can publish plans for the community
  createdById String?  // null once the creator deletes their account
  createdBy   User?    @relation("CreatedCommunities", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  members     CommunityMember[]
  events      Event[]
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // "admin" | "member"
  status      String    @default("active") // "active" | "pending" | "rejected"
  note        String    @default("")       // e.g. "Soy charterholder desde 2019"
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
}

model Session {
  id        String   @id // random token stored in cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  hostId      String
  host        User     @relation("HostedEvents", fields: [hostId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String
  comuna      String           // always public: only the area is shown by default
  venue       String   @default("") // exact place, revealed only to accepted attendees...
  venuePublic Boolean  @default(false) // ...unless the place IS the plan (a concert, a play)
  startsAt    DateTime
  capacity    Int              // includes the host; small groups only (max 12)
  joinMode    String   @default("review")   // "instant" | "review"
  chatMode    String   @default("both")     // "none" | "before" | "after" | "both"
  shareContacts Boolean @default(false)     // host lets attendees see each other's contact after the event
  audience    String   @default("open")     // "open" | "women_only" | "lgbtq_only" | "lgbtq_friendly" | "vegan_only"
  costNote    String   @default("")         // what each person pays on their own
  hostPledgeAt DateTime                     // host confirmed: not the provider, no money received
  status      String   @default("active")   // "active" | "cancelled" | "hidden"
  // Optional: plan published on behalf of a community
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  visibility  String   @default("public")   // "public" | "community" (only active members see & join)
  createdAt   DateTime @default(now())

  participations Participation[]
  messages    Message[]
  reports     Report[]

  @@index([startsAt])
  @@index([comuna])
}

model Participation {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // "pending" | "accepted" | "rejected" | "left"
  note      String   @default("")        // why I'd like to join (review mode)
  viaSurprise Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model Message {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Report {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("open") // "open" | "actioned" | "dismissed"
  resolvedAt DateTime?
  resolvedById String?
  createdAt  DateTime @default(now())

  @@unique([eventId, reporterId])
}

// One-time links sent by email. Only the SHA-256 of the token is stored.
model AuthToken {
  id        String    @id // sha256(token)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String    // "verify_email" | "reset_password"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

// Fixed-window rate limiting without extra infrastructure.
model RateHit {
  id        BigInt   @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// A report about a person (harassment, dating intent, selling, no-show...).
model UserReport {
  id           String    @id @default(cuid())
  reportedId   String
  reported     User      @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User      @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  eventId      String?   // the plan where it happened, if any
  reason       String    // "harassment" | "dating" | "selling" | "fake" | "unsafe" | "noshow" | "other"
  details      String    @default("")
  status       String    @default("open") // "open" | "actioned" | "dismissed"
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())

  @@unique([reportedId, reporterId])
  @@index([status, createdAt])
}

// Blocked people never see each other's plans and can't be at the same plan.
model Block {
  blockerId String
  blocker   User     @relation("Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Every staff decision, kept even if the people involved delete their accounts.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String   // "id.approve" | "id.reject" | "user.suspend" | "user.unsuspend" | "event.hide" | "event.restore" | "report.dismiss"
  targetType String   // "user" | "event" | "report"
  targetId   String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
