# Local Postgres (docker compose up -d). On Supabase, DATABASE_URL is the pooled
# connection (port 6543, ?pgbouncer=true) and DIRECT_URL the direct one (port 5432).
DATABASE_URL="postgresql://panoramas:panoramas@localhost:5432/panoramas"
DIRECT_URL="postgresql://panoramas:panoramas@localhost:5432/panoramas"

# ID document storage. Files are always encrypted with ID_DOC_ENCRYPTION_KEY
# (generate: openssl rand -base64 32). Required in production.
ID_DOC_ENCRYPTION_KEY=""
# "local" (./storage/id-docs, dev only) or "supabase" (private bucket).
ID_DOC_STORAGE="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
ID_DOC_BUCKET="id-docs"

# Public URL used in emailed links.
APP_URL="http://localhost:3000"
# Email via Resend. Without a key (dev), emails go to the log and storage/outbox.log.
RESEND_API_KEY=""
EMAIL_FROM="Panoramas <hola@panoramas.cl>"
